#-- crear la imagen
# docker build -f Dockerfile.jvm -t pablofernandosimbana/web-app:latest .
# docker login
# docker push pablofernandosimbana/web-app:latest
#

FROM docker.io/node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# variante sin root: compatible con el UID aleatorio de OpenShift (restricted SCC)
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
